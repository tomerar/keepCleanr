<resources>
    <style name="Theme.KeepClear" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <!-- PR H3: paper behind everything until Compose draws (no white or black flash). -->
        <item name="android:windowBackground">@color/kc_window_background</item>
    </style>

    <!-- PR H3 (owner brief H3 item 6): the starting window, core-splashscreen on every API (30 too): paper background,
         the app's mark, then Theme.KeepClear. -->
    <style name="Theme.KeepClear.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/kc_window_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_option1_foreground</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/kc_splash_icon_background</item>
        <item name="postSplashScreenTheme">@style/Theme.KeepClear</item>
    </style>
</resources>
