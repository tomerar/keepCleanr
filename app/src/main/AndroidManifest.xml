<?xml version="1.0" encoding="utf-8"?>
<!-- SPDX-License-Identifier: GPL-3.0-or-later -->
<!-- Common manifest. No restricted or network permissions here (ADR 0005, ADR 0008). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Media access, requested only when the user taps "Allow access" (ONB-2). -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />

    <!-- MOVE (M10): copy and verify run in a dataSync foreground service; progress notification (ONB-10). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Owner brief H1 item 5: Android 16 Live Update of the backup's progress (a normal permission). -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />

    <!-- M13 / ONB-7: Usage access (a special access the user turns on in Settings), asked only when Apps is opened:
         app sizes and when each app was last opened, read on this phone only. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- M13: needed (API 28+) to open Android's own uninstall window (ACTION_DELETE); Android asks the user. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <!-- MOVE-16: open Google Photos' own "Free up space" (package visibility for this one app only). -->
    <queries>
        <package android:name="com.google.android.apps.photos" />
        <!-- SAFE-9/10: names of launchable apps, to show "Inside apps' folders" and "Clear one app at a time".
             No permission and no list leaves the phone. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <!-- WorkManager (daily trash purge) would add this; KeepClear has no network in the MVP (ADR 0008). -->
    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE"
        tools:node="remove" />

    <application
        android:name=".KeepClearApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/launcher_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.KeepClear"
        tools:targetApi="33">
        <!-- PR H3: starts on the paper splash (core-splashscreen), then Theme.KeepClear. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.KeepClear.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- PR H3 (owner brief H3 item 7): launcher shortcuts; they only open a screen (ShortcutRoute). -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- PR H3 (owner brief H3 item 2): shares only the diagnostics file KeepClear writes in its own cache, read-only,
             to the email app the user picks (res/xml/report_paths.xml). Not exported. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.reports"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/report_paths" />
        </provider>

        <service
            android:name=".MoveService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Notification pause/stop actions: explicit, immutable PendingIntents only (SEC-5). -->
        <receiver
            android:name=".MoveControlReceiver"
            android:exported="false" />

        <!-- MIG-4: after an update, an unfinished backup waits for the user. -->
        <receiver
            android:name=".PackageReplacedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
