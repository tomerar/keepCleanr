<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Test-only USB drive. Inert and hidden from the system picker until a test enables it. -->
        <provider
            android:name="io.github.tomerar.keepclear.testing.usb.FakeUsbProvider"
            android:authorities="${applicationId}.testusb"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>
    </application>
</manifest>
